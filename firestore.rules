rules_version = '2';

// Reglas de seguridad de Cloud Firestore.
// - Solo se permite la colección "vehiculos"; todo lo demás está bloqueado.
// - Un registro nuevo debe traer exactamente los campos esperados, con el
//   tipo y la longitud correctos (evita registros vacíos o basura).
// - No se puede sobrescribir un vehículo existente (la placa es el ID).
service cloud.firestore {
  match /databases/{database}/documents {

    function textoValido(v, min, max) {
      return v is string && v.trim().size() >= min && v.size() <= max;
    }

    function vehiculoValido(placa) {
      let d = request.resource.data;
      return d.keys().hasOnly(['placa', 'marca', 'modelo', 'anio', 'color',
                               'tipo', 'propietario', 'fechaRegistro'])
        && d.keys().hasAll(['placa', 'marca', 'modelo', 'anio', 'color',
                            'tipo', 'propietario', 'fechaRegistro'])
        && d.placa == placa
        && d.placa.matches('^[A-Z0-9-]{5,10}$')
        && textoValido(d.marca, 2, 40)
        && textoValido(d.modelo, 1, 40)
        && d.anio is int && d.anio >= 1950 && d.anio <= 2100
        && textoValido(d.color, 3, 60)
        && d.tipo in ['Automóvil', 'Camioneta', 'Motocicleta', 'Camión', 'Otro']
        && textoValido(d.propietario, 3, 60)
        && d.fechaRegistro == request.time;
    }

    match /vehiculos/{placa} {
      allow read: if true;
      allow create: if vehiculoValido(placa);
      allow update: if false;
      allow delete: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
